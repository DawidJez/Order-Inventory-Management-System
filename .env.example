DB_NAME=orderinventory
DB_URL=jdbc:postgresql://localhost:5432/orderinventory
DB_USERNAME=orderinventory
DB_PASSWORD=changeme

# At least 32 characters (HS256 needs a 256-bit key). Generate e.g. with: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-string-min-32-chars
JWT_EXPIRATION_MS=3600000

# Administrator account created on first startup
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme-admin
