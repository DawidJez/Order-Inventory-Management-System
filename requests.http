### Variables (host, adminEmail, adminPassword) live in http-client.private.env.json (gitignored)

### Register a regular user -> 201, role USER
POST http://localhost:8080/api/auth/register
Content-Type: application/json

{
  "email": "user@example.com",
  "password": "password123",
  "firstName": "Jan",
  "lastName": "Kowalski"
}

### Register the same email again -> expect 409
POST http://localhost:8080/api/auth/register
Content-Type: application/json

{
  "email": "USER@example.com",
  "password": "password123",
  "firstName": "Jan",
  "lastName": "Kowalski"
}

### Invalid registration (bad email, short password) -> expect 400
POST http://localhost:8080/api/auth/register
Content-Type: application/json

{
  "email": "not-an-email",
  "password": "123",
  "firstName": "",
  "lastName": "X"
}

### Login as USER, saves the token
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{
  "email": "user@example.com",
  "password": "password123"
}

> {% client.global.set("userToken", response.body.accessToken); %}

### Login as ADMIN (credentials from .env), saves the token
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

> {% client.global.set("adminToken", response.body.accessToken); %}

### Wrong password -> expect 401
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{
  "email": "user@example.com",
  "password": "wrong-password"
}

### Create product without a token -> expect 401
POST http://localhost:8080/api/products
Content-Type: application/json

{
  "sku": "NOAUTH-1",
  "name": "No token",
  "price": 1.00
}

### Create product as USER -> expect 403
POST http://localhost:8080/api/products
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "sku": "USER-1",
  "name": "As user",
  "price": 1.00
}

### Create a product (initialQuantity is optional, defaults to 0)
POST http://localhost:8080/api/products
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "sku": "KB-001",
  "name": "Mechanical keyboard",
  "description": "Hot-swappable, 75% layout",
  "price": 249.99,
  "initialQuantity": 10
}

### Create the same SKU again -> expect 409
POST http://localhost:8080/api/products
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "sku": "KB-001",
  "name": "Duplicate",
  "price": 1.00
}

### Invalid body (blank name, negative price) -> expect 400
POST http://localhost:8080/api/products
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "sku": "BAD-001",
  "name": "",
  "price": -5
}

### Get one product
GET http://localhost:8080/api/products/1

### Get a product that does not exist -> expect 404
GET http://localhost:8080/api/products/999

### List products
GET http://localhost:8080/api/products

### Update a product
PUT http://localhost:8080/api/products/1
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Mechanical keyboard v2",
  "description": "Hot-swappable, 75% layout, new switches",
  "price": 279.99
}

### Check stock
GET http://localhost:8080/api/products/1/stock

### Restock 5 units
POST http://localhost:8080/api/products/1/stock/restock
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "quantity": 5
}

### Restock with an invalid quantity -> expect 400
POST http://localhost:8080/api/products/1/stock/restock
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "quantity": 0
}


### ===== Orders (needs a product with stock, e.g. product 1 restocked above, and userToken) =====

### Place an order as USER -> 201, status CREATED, saves the order id
POST http://localhost:8080/api/orders
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "items": [
    { "productId": 1, "quantity": 2 }
  ]
}

> {% client.global.set("orderId", response.body.id); %}

### Stock after the order -> quantityReserved should grow by 2
GET http://localhost:8080/api/products/1/stock

### Place an order without a token -> expect 401
POST http://localhost:8080/api/orders
Content-Type: application/json

{
  "items": [
    { "productId": 1, "quantity": 1 }
  ]
}

### More than available -> expect 409
POST http://localhost:8080/api/orders
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "items": [
    { "productId": 1, "quantity": 100000 }
  ]
}

### Unknown product -> expect 404
POST http://localhost:8080/api/orders
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "items": [
    { "productId": 999, "quantity": 1 }
  ]
}

### Same product twice -> expect 400
POST http://localhost:8080/api/orders
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "items": [
    { "productId": 1, "quantity": 1 },
    { "productId": 1, "quantity": 2 }
  ]
}

### Empty items / quantity 0 -> expect 400
POST http://localhost:8080/api/orders
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "items": [
    { "productId": 1, "quantity": 0 }
  ]
}

### My orders
GET http://localhost:8080/api/orders
Authorization: Bearer {{userToken}}

### One of my orders
GET http://localhost:8080/api/orders/{{orderId}}
Authorization: Bearer {{userToken}}

### ADMIN sees every order
GET http://localhost:8080/api/orders
Authorization: Bearer {{adminToken}}

### Cancel the order -> status CANCELLED
POST http://localhost:8080/api/orders/{{orderId}}/cancel
Authorization: Bearer {{userToken}}

### Stock after cancelling -> quantityReserved back to the previous value
GET http://localhost:8080/api/products/1/stock

### Cancel again -> expect 409
POST http://localhost:8080/api/orders/{{orderId}}/cancel
Authorization: Bearer {{userToken}}

